  "text": "{{\n  (() => {\n    const invoice = TableInvoiceHeader.tableData?.[0] || {};\n    const dateValue = invoice.invoice_date;\n\n    const dateText = dateValue\n      ? String(dateValue).slice(0, 10).split(\"-\").reverse().join(\"/\")\n      : new Date().toLocaleDateString(\"en-GB\");\n\n    const timeText = new Date().toLocaleTimeString(\"en-GB\", {\n      hour: \"2-digit\",\n      minute: \"2-digit\"\n    });\n\n    return \"Invoice: \" + (invoice.invoice_number || \"New\") + \" | Date: \" + dateText + \" | Time: \" + timeText;\n  })()\n}}",
